@prefix : <http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix swrlb: <http://www.w3.org/2003/11/swrlb#> .
@base <http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#> .

<http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage> rdf:type owl:Ontology ;
                                       owl:imports <http://www.w3.org/2002/07/owl> ;
                                       rdfs:comment "Parafrase orisinal dari ide B-Team 3. TASK SPESIFIK (dikunci): Triase Tuntas. input cerita bahasa sehari-hari, output wajib 5 (instansi + versi akta + ceklis dokumen kurang/sudah + status + langkah berikutnya), chatbot dilarang tutup sebelum slot lengkap. SKEMA GANTI TOTAL: tidak memakai skema knowledge-graph regulasi maupun portal-layanan-publik existing; kelas inti orisinal: CeritaAwam, KasusTriage, JenisTransaksi, StatusPenanganan, saranLangkah, butuhAkta, ditanganiOleh. Layer: core generik + hukum Indonesia (UUJN/PPAT/KUHPerdata) + domain Notaris/PPAT + inferensi SWRL."@id ;
                                       rdfs:label "Notaris Triage Ontologi pendamping awam untuk layanan Notaris/PPAT"@id ;
                                       owl:versionInfo "0.2.0 task Triase Tuntas + skema ganti total, desk research, OWL DL" .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/2003/11/swrl#argument1
swrl:argument1 rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/11/swrl#argument2
swrl:argument2 rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/11/swrl#body
swrl:body rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/11/swrl#classPredicate
swrl:classPredicate rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/11/swrl#head
swrl:head rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/11/swrl#propertyPredicate
swrl:propertyPredicate rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#aktaUntuk
:aktaUntuk rdf:type owl:ObjectProperty ;
           owl:inverseOf :butuhAkta ;
           rdfs:domain :Akta ;
           rdfs:range :KasusTriage ;
           rdfs:label "akta untuk"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#berdasarPada
:berdasarPada rdf:type owl:ObjectProperty ;
              rdfs:domain :Akta ;
              rdfs:range :AturanHukum ;
              rdfs:label "berdasar pada"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#berstatus
:berstatus rdf:type owl:ObjectProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain :KasusTriage ;
           rdfs:range :StatusPenanganan ;
           rdfs:comment "Setiap kasus hanya punya satu status aktif."@id ;
           rdfs:label "berstatus"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#butuhAkta
:butuhAkta rdf:type owl:ObjectProperty ;
           rdfs:domain :KasusTriage ;
           rdfs:range :Akta ;
           rdfs:label "butuh akta"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#butuhDokumen
:butuhDokumen rdf:type owl:ObjectProperty ;
              rdfs:domain :KasusTriage ;
              rdfs:range :DokumenSyarat ;
              rdfs:comment "Dokumen yang masih kurang / harus disiapkan."@id ;
              rdfs:label "butuh dokumen"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#dasarKasus
:dasarKasus rdf:type owl:ObjectProperty ;
            rdfs:domain :KasusTriage ;
            rdfs:range :AturanHukum ;
            rdfs:label "dasar kasus"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#dikenaiBiaya
:dikenaiBiaya rdf:type owl:ObjectProperty ;
              rdfs:domain :KasusTriage ;
              rdfs:range :KomponenBiaya ;
              rdfs:label "dikenai biaya"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#ditanganiOleh
:ditanganiOleh rdf:type owl:ObjectProperty ;
               owl:inverseOf :menangani ;
               rdfs:domain :KasusTriage ;
               rdfs:range :Lembaga ;
               rdfs:comment "Kasus diarahkan ke lembaga mana."@id ;
               rdfs:label "ditangani oleh"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#melibatkanTokoh
:melibatkanTokoh rdf:type owl:ObjectProperty ;
                 rdfs:domain :KasusTriage ;
                 rdfs:range :Tokoh ;
                 rdfs:label "melibatkan tokoh"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#menangani
:menangani rdf:type owl:ObjectProperty ;
           rdfs:domain :Lembaga ;
           rdfs:range :KasusTriage ;
           rdfs:label "menangani"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#menceritakan
:menceritakan rdf:type owl:ObjectProperty ;
              rdfs:domain :CeritaAwam ;
              rdfs:range :KasusTriage ;
              rdfs:label "menceritakan"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#perluDaftarDi
:perluDaftarDi rdf:type owl:ObjectProperty ;
               rdfs:domain :Akta ;
               rdfs:range :Lembaga ;
               rdfs:label "perlu daftar di"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#punyaJenis
:punyaJenis rdf:type owl:ObjectProperty ;
            rdfs:domain :KasusTriage ;
            rdfs:range :JenisTransaksi ;
            rdfs:label "punya jenis keperluan"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#punyaObjek
:punyaObjek rdf:type owl:ObjectProperty ;
            rdfs:domain :KasusTriage ;
            rdfs:range :ObjekHukum ;
            rdfs:label "punya objek"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#sudahPunyaDokumen
:sudahPunyaDokumen rdf:type owl:ObjectProperty ;
                   rdfs:domain :KasusTriage ;
                   rdfs:range :DokumenSyarat ;
                   rdfs:label "sudah punya dokumen"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#terkaitAturan
:terkaitAturan rdf:type owl:ObjectProperty ,
                        owl:TransitiveProperty ;
               rdfs:domain :AturanHukum ;
               rdfs:range :AturanHukum ;
               rdfs:comment "Contoh transitive: jika A terkait B dan B terkait C maka A terkait C."@id ;
               rdfs:label "terkait aturan"@id .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#adaSKWaris
:adaSKWaris rdf:type owl:DatatypeProperty ;
            rdfs:domain :KasusTriage ;
            rdfs:range xsd:boolean ;
            rdfs:label "ada surat waris"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#adaSepakat
:adaSepakat rdf:type owl:DatatypeProperty ;
            rdfs:domain :KasusTriage ;
            rdfs:range xsd:boolean ;
            rdfs:label "ada kesepakatan semua pihak"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#adaSertifikat
:adaSertifikat rdf:type owl:DatatypeProperty ;
               rdfs:domain :KasusTriage ;
               rdfs:range xsd:boolean ;
               rdfs:label "ada sertifikat"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#cakapHukum
:cakapHukum rdf:type owl:DatatypeProperty ;
            rdfs:domain :KasusTriage ;
            rdfs:range xsd:boolean ;
            rdfs:label "cakap hukum"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#jumlahPendiri
:jumlahPendiri rdf:type owl:DatatypeProperty ;
               rdfs:domain :KasusTriage ;
               rdfs:range xsd:integer ;
               rdfs:label "jumlah pendiri"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#modalKecil
:modalKecil rdf:type owl:DatatypeProperty ;
            rdfs:domain :KasusTriage ;
            rdfs:range xsd:boolean ;
            rdfs:label "modal kecil (usaha mikro)"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#penjelasanAwam
:penjelasanAwam rdf:type owl:DatatypeProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( :Akta
                                            :AturanHukum
                                            :JenisTransaksi
                                            :KomponenBiaya
                                            :Lembaga
                                            :ObjekHukum
                                            :StatusPenanganan
                                          )
                            ] ;
                rdfs:range xsd:string ;
                rdfs:comment "Domain dibatasi union 7 kelas yang memang punya penjelasan awam — tidak seumum owl:Thing, tidak sesempit satu kelas."@id ;
                rdfs:label "penjelasan awam"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#perkiraanBiaya
:perkiraanBiaya rdf:type owl:DatatypeProperty ;
                rdfs:domain :KasusTriage ;
                rdfs:range xsd:string ;
                rdfs:label "perkiraan biaya"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#perkiraanWaktu
:perkiraanWaktu rdf:type owl:DatatypeProperty ;
                rdfs:domain :KasusTriage ;
                rdfs:range xsd:string ;
                rdfs:label "perkiraan waktu"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#saranLangkah
:saranLangkah rdf:type owl:DatatypeProperty ;
              rdfs:domain :KasusTriage ;
              rdfs:range xsd:string ;
              rdfs:label "saran langkah"@id .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#AhliWaris
:AhliWaris rdf:type owl:Class ;
           rdfs:subClassOf :Tokoh ;
           rdfs:label "Ahli waris"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#Akta
:Akta rdf:type owl:Class ;
      rdfs:comment "Produk hukum: akta jual beli, hibah, fidusia, wasiat, pendirian usaha, dsb."@id ;
      rdfs:label "Akta dan surat"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#AktaBagiWaris
:AktaBagiWaris rdf:type owl:Class ;
               rdfs:subClassOf :Akta ;
               rdfs:label "Akta pembagian hak bersama (APHB)"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#AktaCV
:AktaCV rdf:type owl:Class ;
        rdfs:subClassOf :AktaUsaha ;
        rdfs:label "Akta pendirian CV"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#AktaFidusia
:AktaFidusia rdf:type owl:Class ;
             rdfs:subClassOf :AktaJaminan ;
             rdfs:label "Akta fidusia"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#AktaHibahTanah
:AktaHibahTanah rdf:type owl:Class ;
                rdfs:subClassOf :Akta ;
                rdfs:label "Akta hibah tanah"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#AktaJaminan
:AktaJaminan rdf:type owl:Class ;
             rdfs:subClassOf :Akta ;
             rdfs:label "Akta jaminan utang"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#AktaJualBeli
:AktaJualBeli rdf:type owl:Class ;
              rdfs:subClassOf :Akta ;
              rdfs:label "Akta jual beli (AJB)"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#AktaPTBiasa
:AktaPTBiasa rdf:type owl:Class ;
             rdfs:subClassOf :AktaUsaha ;
             rdfs:label "Akta pendirian PT biasa"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#AktaPTPerorangan
:AktaPTPerorangan rdf:type owl:Class ;
                  rdfs:subClassOf :AktaUsaha ;
                  rdfs:label "Pernyataan PT perorangan"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#AktaPerjanjianKawin
:AktaPerjanjianKawin rdf:type owl:Class ;
                     rdfs:subClassOf :Akta ;
                     rdfs:label "Akta perjanjian kawin"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#AktaHakTanggungan
:AktaHakTanggungan rdf:type owl:Class ;
                   rdfs:subClassOf :AktaJaminan ;
                   rdfs:comment "Akta POKOK pembebanan Hak Tanggungan atas tanah (UUHT No.4/1996): dibuat di hadapan PPAT dan wajib didaftarkan ke BPN. Berbeda dengan SKMHT yang hanya kuasa pendahulunya."@id ;
                   rdfs:label "Akta Pemberian Hak Tanggungan (APHT)"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#SuratKuasaMembebankan
:SuratKuasaMembebankan rdf:type owl:Class ;
                       rdfs:subClassOf :Akta ;
                       rdfs:comment "SKMHT BUKAN akta jaminan: kuasa otentik untuk memasang APHT, dibuat di hadapan Notaris/PPAT, dan wajib diikuti APHT dalam batas waktu UUHT. SKMHT sendiri tidak didaftarkan ke BPN."@id ;
                       rdfs:label "SKMHT — kuasa membebankan Hak Tanggungan"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#AktaUsaha
:AktaUsaha rdf:type owl:Class ;
           rdfs:subClassOf :Akta ;
           rdfs:label "Akta usaha"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#AktaWasiat
:AktaWasiat rdf:type owl:Class ;
            rdfs:subClassOf :Akta ;
            rdfs:label "Akta wasiat"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#AturanHukum
:AturanHukum rdf:type owl:Class ;
             rdfs:comment "Dasar hukum: UUJN, aturan PPAT, KUHPerdata, dsb."@id ;
             rdfs:label "Aturan hukum"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#CeritaAwam
:CeritaAwam rdf:type owl:Class ;
            rdfs:comment "Ungkapan masalah dalam bahasa sehari-hari, misalnya 'mau jual tanah warisan'."@id ;
            rdfs:label "Cerita awam"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#DokumenSyarat
:DokumenSyarat rdf:type owl:Class ;
               rdfs:comment "Berkas yang harus dibawa: KTP, sertifikat, PBB, dsb."@id ;
               rdfs:label "Dokumen syarat"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#JenisTransaksi
:JenisTransaksi rdf:type owl:Class ;
                rdfs:comment "Kategori kebutuhan awam: jual beli, waris, hibah, usaha, utang, wasiat, kawin."@id ;
                rdfs:label "Jenis keperluan"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#KasusTriage
:KasusTriage rdf:type owl:Class ;
             rdfs:comment "Hasil pemetaan cerita awam menjadi peristiwa hukum yang siap ditangani."@id ;
             rdfs:label "Kasus triase"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#KomponenBiaya
:KomponenBiaya rdf:type owl:Class ;
               rdfs:comment "Honorarium, pajak, dan PNBP yang mungkin muncul."@id ;
               rdfs:label "Komponen biaya"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#Lembaga
:Lembaga rdf:type owl:Class ;
         rdfs:comment "Tempat mengurus: kantor notaris, PPAT, pengadilan, BPN, AHU, Dukcapil."@id ;
         rdfs:label "Lembaga berwenang"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#ObjekHukum
:ObjekHukum rdf:type owl:Class ;
            rdfs:comment "Benda atau hak yang diurus: tanah, bangunan, kendaraan, saham."@id ;
            rdfs:label "Objek hukum"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#PejabatNotaris
:PejabatNotaris rdf:type owl:Class ;
                rdfs:subClassOf :Tokoh ;
                rdfs:label "Pejabat notaris"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#PejabatPPAT
:PejabatPPAT rdf:type owl:Class ;
             rdfs:subClassOf :Tokoh ;
             rdfs:label "Pejabat PPAT"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#PeristiwaHukum
:PeristiwaHukum rdf:type owl:Class ;
                rdfs:comment "Kejadian yang menimbulkan akibat hukum, misalnya jual beli atau pewarisan."@id ;
                rdfs:label "Peristiwa hukum"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#SaksiAkta
:SaksiAkta rdf:type owl:Class ;
           rdfs:subClassOf :Tokoh ;
           rdfs:label "Saksi akta"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#StatusPenanganan
:StatusPenanganan rdf:type owl:Class ;
                  rdfs:comment "Posisi kasus: belum lengkap, siap ke notaris/PPAT, rujuk pengadilan, tuntas."@id ;
                  rdfs:label "Status penanganan"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#SuratWaris
:SuratWaris rdf:type owl:Class ;
            rdfs:subClassOf :Akta ;
            rdfs:label "Surat keterangan waris"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#Tokoh
:Tokoh rdf:type owl:Class ;
       rdfs:comment "Orang yang terlibat: warga, notaris, PPAT, saksi, ahli waris."@id ;
       rdfs:label "Tokoh"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#WargaAwam
:WargaAwam rdf:type owl:Class ;
           rdfs:subClassOf :Tokoh ;
           rdfs:label "Warga awam"@id .


#################################################################
#    Individuals
#################################################################

###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#akta_AJB
:akta_AJB rdf:type owl:NamedIndividual ,
                   :AktaJualBeli ;
          :berdasarPada :aturan_ppat ,
                        :aturan_tanah ;
          :perluDaftarDi :lem_bpn ;
          :penjelasanAwam "Akta jual beli tanah di depan PPAT, lalu balik nama di BPN."@id ;
          rdfs:label "AJB"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#akta_APHT
:akta_APHT rdf:type owl:NamedIndividual ,
                    :AktaHakTanggungan ;
           :berdasarPada :aturan_uuht ;
           :perluDaftarDi :lem_bpn ;
           :penjelasanAwam "Akta pokok jaminan tanah untuk kredit bank: dibuat di PPAT lalu didaftar ke BPN. Didahului SKMHT bila pemilik tidak hadir."@id ;
           rdfs:label "APHT"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#akta_CV
:akta_CV rdf:type owl:NamedIndividual ,
                  :AktaCV ;
         :perluDaftarDi :lem_ahu ;
         :penjelasanAwam "Persekutuan komanditer untuk usaha kecil menengah."@id ;
         rdfs:label "CV"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#akta_PHB
:akta_PHB rdf:type owl:NamedIndividual ,
                   :AktaBagiWaris ;
          :berdasarPada :aturan_ppat ;
          :perluDaftarDi :lem_bpn ;
          :penjelasanAwam "Akta pembagian hak bersama untuk waris yang sudah sepakat."@id ;
          rdfs:label "APHB"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#akta_PTbiasa
:akta_PTbiasa rdf:type owl:NamedIndividual ,
                       :AktaPTBiasa ;
              :berdasarPada :aturan_pt ;
              :perluDaftarDi :lem_ahu ;
              :penjelasanAwam "Perseroan 2+ pendiri dengan akta notaris."@id ;
              rdfs:label "PT biasa"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#akta_PTperorangan
:akta_PTperorangan rdf:type owl:NamedIndividual ,
                            :AktaPTPerorangan ;
                   :berdasarPada :aturan_pt ;
                   :perluDaftarDi :lem_ahu ;
                   :penjelasanAwam "Badan usaha 1 orang, daftar online ke AHU, cocok untuk mikro."@id ;
                   rdfs:label "PT perorangan"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#akta_SKMHT
:akta_SKMHT rdf:type owl:NamedIndividual ,
                     :SuratKuasaMembebankan ;
            :berdasarPada :aturan_uuht ;
            :penjelasanAwam "Kuasa otentik agar bank/notaris bisa memasang APHT. Bukan jaminan itu sendiri dan tidak didaftar ke BPN; wajib disusul APHT."@id ;
            rdfs:label "SKMHT"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#akta_fidusia
:akta_fidusia rdf:type owl:NamedIndividual ,
                       :AktaFidusia ;
              :berdasarPada :aturan_fidusia ;
              :perluDaftarDi :lem_ahu ;
              :penjelasanAwam "Jaminan tanpa serah barang: motor tetap dipakai tapi terikat utang."@id ;
              rdfs:label "Akta fidusia"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#akta_hibah
:akta_hibah rdf:type owl:NamedIndividual ,
                     :AktaHibahTanah ;
            :berdasarPada :aturan_ppat ;
            :perluDaftarDi :lem_bpn ;
            :penjelasanAwam "Akta pemberian tanah cuma-cuma, dibuat di PPAT."@id ;
            rdfs:label "Akta hibah"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#akta_kawin
:akta_kawin rdf:type owl:NamedIndividual ,
                     :AktaPerjanjianKawin ;
            :berdasarPada :aturan_kawin ;
