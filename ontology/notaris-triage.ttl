                              :KasusTriage ;
                     :berstatus :status_siapNotaris ;
                     :butuhAkta :akta_fidusia ;
                     :dasarKasus :aturan_fidusia ;
                     :dikenaiBiaya :biaya_PNBP_AHU ,
                                   :biaya_honorNotaris ;
                     :ditanganiOleh :lem_notaris ;
                     :punyaJenis :trans_utangJaminan ;
                     :punyaObjek :obj_kendaraan ;
                     :adaSepakat "true"^^xsd:boolean ;
                     :cakapHukum "true"^^xsd:boolean ;
                     :perkiraanBiaya "Honor notaris + PNBP fidusia."@id ;
                     :perkiraanWaktu "Akta 1-3 hari; daftar online 1 hari."@id ;
                     :saranLangkah "Bawa BPKB + perjanjian utang, buat akta fidusia di notaris, daftarkan online."@id ;
                     rdfs:label "Kasus 7: utang jaminan motor"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#kasus_hibah_tanah
:kasus_hibah_tanah rdf:type owl:NamedIndividual ,
                            :KasusTriage ;
                   :berstatus :status_siapPPAT ;
                   :butuhAkta :akta_hibah ;
                   :dasarKasus :aturan_ppat ;
                   :dikenaiBiaya :biaya_BPHTB ,
                                 :biaya_PNBP_BPN ,
                                 :biaya_honorPPAT ;
                   :ditanganiOleh :lem_ppat ;
                   :punyaJenis :trans_hibah ;
                   :punyaObjek :obj_tanahSHM ;
                   :adaSepakat "true"^^xsd:boolean ;
                   :adaSertifikat "true"^^xsd:boolean ;
                   :cakapHukum "true"^^xsd:boolean ;
                   :perkiraanBiaya "Honor PPAT + BPHTB hibah + PNBP BPN."@id ;
                   :perkiraanWaktu "Akta hibah 1-7 hari; balik nama 5-14 hari."@id ;
                   :saranLangkah "Siapkan SHM + PBB + KK yang menunjukkan hubungan, tanda tangan akta hibah di PPAT."@id ;
                   rdfs:label "Kasus 4: hibah tanah ke anak"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#kasus_jualbeli_shm
:kasus_jualbeli_shm rdf:type owl:NamedIndividual ,
                             :KasusTriage ;
                    :berstatus :status_siapPPAT ;
                    :butuhAkta :akta_AJB ;
                    :butuhDokumen :dok_NPWP ,
                                  :dok_PBB ,
                                  :dok_SHM ;
                    :dasarKasus :aturan_ppat ,
                                :aturan_tanah ;
                    :dikenaiBiaya :biaya_BPHTB ,
                                  :biaya_PNBP_BPN ,
                                  :biaya_PPh ,
                                  :biaya_honorPPAT ;
                    :ditanganiOleh :lem_ppat ;
                    :punyaJenis :trans_jualBeli ;
                    :punyaObjek :obj_tanahSHM ;
                    :sudahPunyaDokumen :dok_KK ,
                                       :dok_KTP ;
                    :adaSepakat "true"^^xsd:boolean ;
                    :adaSertifikat "true"^^xsd:boolean ;
                    :cakapHukum "true"^^xsd:boolean ;
                    :perkiraanBiaya "Honor PPAT + BPHTB (±5% NPOP-NPOPTKP) + PPh 2,5% + PNBP BPN."@id ;
                    :perkiraanWaktu "AJB 1-7 hari bila berkas lengkap; balik nama BPN 5-14 hari."@id ;
                    :saranLangkah "Lengkapi SHM + PBB, cek keaslian di BPN, tanda tangan AJB di PPAT, lalu balik nama."@id ;
                    rdfs:label "Kasus 1: jual beli SHM biasa"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#kasus_kawin
:kasus_kawin rdf:type owl:NamedIndividual ,
                      :KasusTriage ;
             :berstatus :status_siapNotaris ;
             :butuhAkta :akta_kawin ;
             :dasarKasus :aturan_kawin ;
             :dikenaiBiaya :biaya_honorNotaris ;
             :ditanganiOleh :lem_notaris ;
             :punyaJenis :trans_kawinHarta ;
             :punyaObjek :obj_hartaKawin ;
             :adaSepakat "true"^^xsd:boolean ;
             :cakapHukum "true"^^xsd:boolean ;
             :perkiraanBiaya "Honor notaris + biaya pencatatan."@id ;
             :perkiraanWaktu "Akta 1-3 hari; pencatatan 3-7 hari."@id ;
             :saranLangkah "Buat sebelum/sesudah nikah di notaris, lalu catatkan ke Dukcapil dan KUA/Dukcapil."@id ;
             rdfs:label "Kasus 9: perjanjian pisah harta"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#kasus_ptperorangan
:kasus_ptperorangan rdf:type owl:NamedIndividual ,
                             :KasusTriage ;
                    :berstatus :status_siapNotaris ;
                    :butuhAkta :akta_PTperorangan ;
                    :dasarKasus :aturan_pt ;
                    :dikenaiBiaya :biaya_PNBP_AHU ;
                    :ditanganiOleh :lem_ahu ;
                    :punyaJenis :trans_dirikanUsaha ;
                    :punyaObjek :obj_sahamUsaha ;
                    :adaSepakat "true"^^xsd:boolean ;
                    :cakapHukum "true"^^xsd:boolean ;
                    :jumlahPendiri 1 ;
                    :modalKecil "true"^^xsd:boolean ;
                    :perkiraanBiaya "PNBP AHU ±50rb + materai; notaris opsional."@id ;
                    :perkiraanWaktu "1-3 hari online bila nama lolos."@id ;
                    :saranLangkah "Cek nama di AHU Online, isi pernyataan pendirian, daftar. Notaris opsional tapi disarankan."@id ;
                    rdfs:label "Kasus 5: dirikan PT perorangan"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#kasus_waris_belumSKW
:kasus_waris_belumSKW rdf:type owl:NamedIndividual ,
                               :KasusTriage ;
                      :berstatus :status_belumLengkap ;
                      :butuhAkta :akta_AJB ;
                      :butuhDokumen :dok_PBB ,
                                    :dok_SHM ,
                                    :dok_SKWaris ;
                      :dasarKasus :aturan_ppat ,
                                  :aturan_warisPerdata ;
                      :dikenaiBiaya :biaya_BPHTB ,
                                    :biaya_honorPPAT ;
                      :ditanganiOleh :lem_ppat ;
                      :punyaJenis :trans_warisJual ;
                      :punyaObjek :obj_tanahWaris ;
                      :sudahPunyaDokumen :dok_AktaKematian ,
                                         :dok_KTP ;
                      :adaSKWaris "false"^^xsd:boolean ;
                      :adaSepakat "true"^^xsd:boolean ;
                      :adaSertifikat "true"^^xsd:boolean ;
                      :cakapHukum "true"^^xsd:boolean ;
                      :perkiraanBiaya "Biaya SKW kecil; AJB + BPHTB + PPh waris bila ada."@id ;
                      :perkiraanWaktu "SKW 7-14 hari; AJB setelahnya 1-7 hari."@id ;
                      :saranLangkah "Urus SK waris dulu (kelurahan/notaris), baru bisa AJB. Jangan tanda tangan apa pun sebelum SKW jadi."@id ;
                      rdfs:label "Kasus 2: jual warisan belum ada SKW"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#kasus_waris_sengketa
:kasus_waris_sengketa rdf:type owl:NamedIndividual ,
                               :KasusTriage ;
                      :berstatus :status_rujukPengadilan ;
                      :butuhAkta :akta_PHB ;
                      :ditanganiOleh :lem_pengadilan ;
                      :punyaJenis :trans_warisBagi ;
                      :punyaObjek :obj_tanahWaris ;
                      :adaSKWaris "false"^^xsd:boolean ;
                      :adaSepakat "false"^^xsd:boolean ;
                      :adaSertifikat "true"^^xsd:boolean ;
                      :cakapHukum "true"^^xsd:boolean ;
                      :perkiraanBiaya "Biaya mediasi/panjar perkara sesuai pengadilan."@id ;
                      :perkiraanWaktu "Mediasi 2-4 minggu; pengadilan 2-6 bulan."@id ;
                      :saranLangkah "Tidak bisa akta dulu. Mediasi keluarga atau penetapan pengadilan agama/negeri dulu."@id ;
                      rdfs:label "Kasus 3: waris tidak sepakat"@id .


