###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#kasus_cv
:kasus_cv rdf:type owl:NamedIndividual ,
                   :KasusTriage ;
          :berstatus :status_siapNotaris ;
          :butuhAkta :akta_CV ;
          :dasarKasus :aturan_pt ;
          :dikenaiBiaya :biaya_PNBP_AHU ,
                        :biaya_honorNotaris ;
          :ditanganiOleh :lem_notaris ;
          :punyaJenis :trans_dirikanUsaha ;
          :punyaObjek :obj_sahamUsaha ;
          :adaSepakat "true"^^xsd:boolean ;
          :cakapHukum "true"^^xsd:boolean ;
          :jumlahPendiri 2 ;
          :modalKecil "true"^^xsd:boolean ;
          :perkiraanBiaya "Honor notaris + PNBP AHU."@id ;
          :perkiraanWaktu "Akta 3-7 hari; pendaftaran AHU 3-5 hari."@id ;
          :saranLangkah "Siapkan KTP pendiri + konsep usaha, buat akta CV di notaris, daftar ke AHU."@id ;
          rdfs:label "Kasus 6: dirikan CV berdua"@id .


###  http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#kasus_fidusia_motor
